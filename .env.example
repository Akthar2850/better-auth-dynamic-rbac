# Copy this file to .env and fill it in.

# Any long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Where the app runs.
BETTER_AUTH_URL=http://localhost:3007

# Only needed to open the app from another machine on your network.
# Use that machine-facing address instead of 192.168.1.50.
# NEXT_PUBLIC_APP_URL=http://192.168.1.50:3007
# TRUSTED_ORIGINS=http://192.168.1.50:3007
# ALLOWED_DEV_ORIGINS=192.168.1.50
